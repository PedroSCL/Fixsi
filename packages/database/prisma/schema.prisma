generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRoleType {
  CLIENT
  PROFESSIONAL
  LOCADOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  FAKE_SERVICE
  WRONG_CATEGORY
  CONTACT_OUTSIDE_PLATFORM
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// ─── Usuário ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  phone         String
  cpf           String   @unique
  avatarUrl     String?
  asaasWalletId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles                UserRole[]
  identityVerification IdentityVerification?
  services             Service[]
  tools                Tool[]
  bookingsAsClient     Booking[]             @relation("ClientBookings")
  reviewsWritten       Review[]              @relation("ReviewAuthor")
  reviewsReceived      Review[]              @relation("ReviewTarget")
  messagesSent         Message[]             @relation("MessageSender")
  proposals            Proposal[]            @relation("ProposalSender")
  reportsMade          Report[]              @relation("ReportsMade")
  sessions             Session[]

  @@index([email])
  @@index([cpf])
}

// ─── Papéis do usuário ────────────────────────────────────────────────────────

model Session {
  id                     String    @id @default(cuid())
  tokenHash              String
  previousTokenHash      String?
  previousTokenExpiresAt DateTime?
  userAgent              String?
  ipAddress              String?
  expiresAt              DateTime
  lastUsedAt             DateTime  @default(now())
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model UserRole {
  id        String       @id @default(cuid())
  type      UserRoleType
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([userId])
}

// ─── Verificação de identidade (KYC) ─────────────────────────────────────────

model IdentityVerification {
  id               String             @id @default(cuid())
  status           VerificationStatus @default(PENDING)
  documentFrontUrl String
  documentBackUrl  String
  selfieUrl        String
  rejectionReason  String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Serviços ─────────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  priceFrom   Decimal?
  images      String[]
  approved    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId   String
  user     User      @relation(fields: [userId], references: [id])
  bookings Booking[]
  reports  Report[]

  @@index([category])
  @@index([userId])
  @@index([approved, active, category])
}

// ─── Ferramentas ──────────────────────────────────────────────────────────────

model Tool {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  pricePerDay Decimal
  usageRules  String?
  images      String[]
  available   Boolean  @default(true)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId   String
  user     User      @relation(fields: [userId], references: [id])
  bookings Booking[]
  reports  Report[]

  @@index([category])
  @@index([userId])
  @@index([available, approved, category])
}

// ─── Agendamento / Pedido ─────────────────────────────────────────────────────

model Booking {
  id        String        @id @default(cuid())
  status    BookingStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clientId String
  client   User   @relation("ClientBookings", fields: [clientId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  toolId String?
  tool   Tool?   @relation(fields: [toolId], references: [id])

  conversation Conversation?
  proposal     Proposal?     @relation("AcceptedProposal")
  payment      Payment?
  reviews      Review[]

  @@index([clientId])
  @@index([status])
}

// ─── Conversa e Mensagens ─────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  messages  Message[]
  proposals Proposal[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
}

// ─── Proposta de orçamento ────────────────────────────────────────────────────

model Proposal {
  id          String         @id @default(cuid())
  amount      Decimal
  description String?
  status      ProposalStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation("ProposalSender", fields: [senderId], references: [id])

  bookingId String?  @unique
  booking   Booking? @relation("AcceptedProposal", fields: [bookingId], references: [id])

  @@index([conversationId])
}

// ─── Pagamento ────────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  status         PaymentStatus @default(PENDING)
  amount         Decimal
  asaasChargeId  String?       @unique
  asaasEscrowId  String?
  pixQrCode      String?
  pixKey         String?
  platformFee    Decimal?
  providerAmount Decimal?
  paidAt         DateTime?
  releasedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ─── Avaliação ────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  visible   Boolean  @default(false)
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([bookingId, authorId])
  @@index([targetId])
  @@index([visible])
}

// ─── Denúncia ─────────────────────────────────────────────────────────────────

model Report {
  id        String       @id @default(cuid())
  reason    ReportReason
  details   String?
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  toolId String?
  tool   Tool?   @relation(fields: [toolId], references: [id])

  @@index([status])
  @@index([serviceId])
}
